<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/yapper_primary_tint" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/yapper_primary_pressed" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/yapper_primary" /><corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="@color/yapper_foreground" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/yapper_primary" /><corners android:radius="4dp" /></shape>
    </item>
</selector>
