<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/yapper_surface_raised" /><corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/yapper_edge" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/yapper_surface" /><corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="@color/yapper_primary_line" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/yapper_surface" /><corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/yapper_edge" /></shape>
    </item>
</selector>
