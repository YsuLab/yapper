<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen and settings, in the Yapper identity: a dither header, status rows, flat controls. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yapper_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/sheet_frame"
            android:clipToOutline="true">

            <com.ysulab.yapper.ui.DitherView
                android:id="@+id/home_field"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/home_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rec_dot" />

                <TextView
                    android:id="@+id/home_readout"
                    style="@style/Yapper.Readout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_readout_idle" />
            </LinearLayout>

            <TextView
                android:id="@+id/build_info"
                style="@style/Yapper.Readout.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="14dp" />
        </FrameLayout>

        <TextView
            style="@style/Yapper.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/app_name" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_setup" />

        <LinearLayout
            android:id="@+id/status_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/status"
            style="@style/Yapper.Readout.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6sp" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_talk" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/talk_help" />

        <Button
            android:id="@+id/btn_ramble"
            style="@style/Yapper.Button.Primary"
            android:text="@string/btn_ramble" />

        <Button
            android:id="@+id/btn_plan"
            style="@style/Yapper.Button"
            android:text="@string/btn_plan" />

        <Button
            android:id="@+id/btn_debrief"
            style="@style/Yapper.Button"
            android:text="@string/btn_debrief" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_capture" />

        <EditText
            android:id="@+id/silence_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_silence"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_transcribers" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transcribers_help" />

        <CheckBox
            android:id="@+id/compare_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compare_all" />

        <LinearLayout
            android:id="@+id/transcribers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_sorter" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorter_help" />

        <EditText
            android:id="@+id/sorter_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sorter_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/sorter_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sorter_model"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/sorter_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/sorter_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorter_shadow" />

        <CheckBox
            android:id="@+id/sorter_move"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorter_move" />

        <CheckBox
            android:id="@+id/sorter_screens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorter_screens" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_reminders" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminders_help" />

        <EditText
            android:id="@+id/ms_client_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ms_client_id"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_ms_sign_in"
            style="@style/Yapper.Button"
            android:text="@string/btn_ms_sign_in" />

        <Button
            android:id="@+id/btn_ms_list"
            style="@style/Yapper.Button"
            android:text="@string/btn_ms_list" />

        <Button
            android:id="@+id/btn_ms_test"
            style="@style/Yapper.Button"
            android:text="@string/btn_ms_test" />

        <Button
            android:id="@+id/btn_ms_sign_out"
            style="@style/Yapper.Button"
            android:text="@string/btn_ms_sign_out" />

        <EditText
            android:id="@+id/alarm_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_alarm_window"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            style="@style/Yapper.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/section_today" />

        <TextView
            style="@style/Yapper.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/today_help" />

        <EditText
            android:id="@+id/nudge_morning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nudge_morning"
            android:inputType="time"
            android:singleLine="true" />

        <EditText
            android:id="@+id/nudge_evening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nudge_evening"
            android:inputType="time"
            android:singleLine="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="@color/yapper_border" />

        <Button
            android:id="@+id/btn_save"
            style="@style/Yapper.Button.Primary"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_retry"
            style="@style/Yapper.Button"
            android:text="@string/btn_retry" />
    </LinearLayout>
</ScrollView>
