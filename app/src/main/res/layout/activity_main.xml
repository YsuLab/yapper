<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_permissions" />

        <Button
            android:id="@+id/btn_assistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_assistant" />

        <Button
            android:id="@+id/btn_vault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_vault" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_capture"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/silence_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_silence"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_transcribers"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transcribers_help"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/compare_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compare_all" />

        <LinearLayout
            android:id="@+id/transcribers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_sorter"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sorter_help"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/sorter_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sorter_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/sorter_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sorter_model"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/sorter_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_key"
            android:inputType="textPassword"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/sorter_shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sorter_shadow" />

        <CheckBox
            android:id="@+id/sorter_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sorter_move" />

        <CheckBox
            android:id="@+id/sorter_screens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sorter_screens" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_retry" />

        <TextView
            android:id="@+id/build_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
