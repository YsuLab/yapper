<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/overlay_card"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/capture_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_listening"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/capture_meter"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:background="#FF7FD1AE"
            android:scaleX="0.04"
            android:transformPivotX="0dp" />

        <TextView
            android:id="@+id/capture_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/capture_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
