<?xml version="1.0" encoding="utf-8"?>
<!-- Capture sheet: the sheet itself is the dither field (moon ripples). Words sit in the corners, in mono. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yapper_scrim"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/capture_sheet"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/sheet_frame"
        android:clipToOutline="true">

        <com.ysulab.yapper.ui.DitherView
            android:id="@+id/capture_field"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/capture_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rec_dot" />

            <TextView
                android:id="@+id/capture_title"
                style="@style/Yapper.Readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/capture_listening" />
        </LinearLayout>

        <TextView
            android:id="@+id/capture_timer"
            style="@style/Yapper.Readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:text="0:00" />

        <TextView
            android:id="@+id/capture_hint"
            style="@style/Yapper.Readout.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:text="@string/capture_hint" />
    </FrameLayout>
</FrameLayout>
