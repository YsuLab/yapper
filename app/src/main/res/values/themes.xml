<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only. Platform Material theme, no AppCompat: colours and fonts come from the identity. -->
    <style name="Theme.Yapper" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yapper_background</item>
        <item name="android:colorBackground">@color/yapper_background</item>
        <item name="android:colorPrimary">@color/yapper_background</item>
        <item name="android:colorPrimaryDark">@color/yapper_background</item>
        <item name="android:colorAccent">@color/yapper_primary_line</item>
        <item name="android:colorControlNormal">@color/yapper_edge</item>
        <item name="android:colorControlActivated">@color/yapper_primary_line</item>
        <item name="android:colorControlHighlight">#33F4EEEC</item>
        <item name="android:textColorPrimary">@color/yapper_foreground</item>
        <item name="android:textColorSecondary">@color/yapper_muted</item>
        <item name="android:textColorHint">@color/yapper_muted</item>
        <item name="android:textColorHighlight">@color/yapper_primary_tint</item>
        <item name="android:statusBarColor">@color/yapper_background</item>
        <item name="android:navigationBarColor">@color/yapper_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
        <item name="android:alertDialogTheme">@style/Theme.Yapper.Dialog</item>
        <item name="android:editTextStyle">@style/Yapper.Field</item>
        <item name="android:checkboxStyle">@style/Yapper.Check</item>
    </style>

    <style name="Theme.Yapper.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/yapper_surface</item>
        <item name="android:colorAccent">@color/yapper_primary_text</item>
        <item name="android:textColorPrimary">@color/yapper_foreground</item>
        <item name="android:textColorSecondary">@color/yapper_muted</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
    </style>

    <!-- Translucent screens (sign-in redirect, ramble trampoline) keep the identity's colours. -->
    <style name="Theme.Yapper.Translucent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:colorAccent">@color/yapper_primary_line</item>
        <item name="android:alertDialogTheme">@style/Theme.Yapper.Dialog</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
    </style>

    <!-- Text. "Yapper" is the empty parent of the Yapper.* styles below. -->
    <style name="Yapper" />
    <style name="Yapper.ScreenTitle">
        <item name="android:fontFamily">@font/shippori_mincho_b1_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/yapper_foreground</item>
    </style>
    <style name="Yapper.SectionTitle">
        <item name="android:fontFamily">@font/shippori_mincho_b1_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/yapper_foreground</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="Yapper.Body">
        <item name="android:fontFamily">@font/yapper_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/yapper_foreground</item>
    </style>
    <style name="Yapper.Hint">
        <item name="android:fontFamily">@font/yapper_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/yapper_muted</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="Yapper.Readout">
        <item name="android:fontFamily">@font/yapper_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/yapper_foreground</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>
    <style name="Yapper.Readout.Muted">
        <item name="android:textColor">@color/yapper_muted</item>
    </style>

    <!-- Controls -->
    <style name="Yapper.Button" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/yapper_foreground</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Yapper.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
    </style>
    <style name="Yapper.Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/field</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/yapper_foreground</item>
        <item name="android:textColorHint">@color/yapper_muted</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="Yapper.Check" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/yapper_primary_line</item>
        <item name="android:textColor">@color/yapper_foreground</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:fontFamily">@font/yapper_sans</item>
    </style>
</resources>
