# Copy to hub/deploy/.env on the VPS and fill in. Never commit .env.
#
# One token per device, so one can be revoked alone. Make each with:  openssl rand -hex 32
HUB_TOKENS=phone=PASTE_64_HEX,tablet=PASTE_64_HEX
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" (the long token).
TUNNEL_TOKEN=PASTE_TUNNEL_TOKEN
HUB_ZONE=Asia/Riyadh
HUB_BACKUP_KEEP=14
